{
  "expo": {
    "name": "CampTrack",
    "slug": "CampTrack-Mobile",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "camptrackmobile",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E120F",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.anonymous.CampTrack-Mobile",
      "buildNumber": "5",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CampTrack uses your location to show local weather, log campsite coordinates, and get directions.",
        "NSPhotoLibraryUsageDescription": "CampTrack needs access to your photos so you can attach them to campsites.",
        "NSPhotoLibraryAddUsageDescription": "CampTrack can save photos you take of campsites."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E120F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E120F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CampTrack uses your location to show local weather, log campsite coordinates, and get directions."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CampTrack needs access to your photos so you can attach them to campsites."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.371464052847-n0n5jrpt6vjc8jlu949iro3a42eooqe5"
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
