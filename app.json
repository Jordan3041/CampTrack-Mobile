{
  "expo": {
    "name": "CampTrack",
    "slug": "CampTrack-Mobile",
    "version": "1.6.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "camptrackmobile",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E120F",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.CampTrackCampTrack-Mobile2026",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CampTrack uses your location to show nearby campsites, local weather conditions, and stream gauge data on the Explorer map, plus log campsite coordinates and get directions.",
        "NSPhotoLibraryUsageDescription": "CampTrack needs access to your photos so you can attach them to campsites.",
        "NSPhotoLibraryAddUsageDescription": "CampTrack can save photos you take of campsites."
      }
    },
    "android": {
      "package": "org.camptrack.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0E120F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E120F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CampTrack uses your location to show nearby campsites, local weather conditions, and stream gauge data on the Explorer map, plus log campsite coordinates and get directions."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CampTrack needs access to your photos so you can attach them to campsites."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.390290853694-43qktr99ptvofdnb32vlakstfcc0douv"
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3ea1075a-a579-40bd-9f82-4fd0b6a76476"
      }
    },
    "owner": "jordan3041"
  }
}
